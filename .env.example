# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored. Never put real keys in this file.
# Restart the dev server after editing .env.local.

# Recommended. The app works without a key, but the anonymous rate limit is
# low enough to hit while planning trips. Free: https://api-v3.mbta.com/register
MBTA_API_KEY=

# Optional. Enables the station assist panel only; the planner works without it.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini. Leaving this blank is fine.
OPENAI_MODEL=
